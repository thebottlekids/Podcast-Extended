# Copy to .env in the Dockge stack and fill in. Dockge can edit this for you.

# --- Transcription (Groq) ---
# Free key from https://console.groq.com
GROQ_API_KEY=gsk_your_groq_key_here

# --- Ad-detection LLM (your local Ollama) ---
# Use the Unraid host's LAN IP, NOT localhost, so the container can reach Ollama.
OPENAI_BASE_URL=http://192.168.1.242:11434/v1
# Ollama ignores the key, but one must be present. Any non-empty value works.
LLM_API_KEY=ollama
# A chat model you've pulled in Ollama (e.g. `ollama pull llama3.1`).
LLM_MODEL=llama3.1

# --- Security (required when exposing to the internet) ---
# Enable login. When true, set the three vars below.
REQUIRE_AUTH=false
PODLY_ADMIN_USERNAME=podly_admin
PODLY_ADMIN_PASSWORD=change_me_strong_password_12chars
# Stable 64-char random string. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Without this, all sessions are lost on container restart.
PODLY_SECRET_KEY=

# --- Reverse proxy settings (set when behind nginx/Caddy/Cloudflare Tunnel/NPM) ---
# Number of trusted reverse proxies in front of the container (usually 1).
# Required for login rate-limiting to work correctly per-client (not per-proxy IP).
TRUSTED_PROXY_COUNT=0
# Set to true when the reverse proxy terminates HTTPS. Marks session cookies Secure.
PODLY_COOKIE_SECURE=false
